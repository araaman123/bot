# Copy this file to `.env` and fill in real values.
# Never commit `.env` — it's in .gitignore.

# --- Discord ---
# Bot token from https://discord.com/developers/applications -> Your App -> Bot -> Reset Token
DISCORD_TOKEN=your_discord_bot_token_here

# Application (Client) ID from General Information -> Application ID
DISCORD_CLIENT_ID=your_discord_application_id_here

# Test server ID. In Discord (with Developer Mode on):
# right-click your server icon -> Copy Server ID.
# Using a guild ID makes slash command updates appear instantly while developing.
DISCORD_GUILD_ID=your_test_server_id_here

# --- Anthropic Claude ---
# Get from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here
